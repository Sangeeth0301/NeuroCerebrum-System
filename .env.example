# Copy to .env and fill in local paths. .env is git-ignored; never commit it.

# ── Datasets (see DATA.md for how to obtain them) ──
TUSZ_ROOT=data/raw/tusz
TUAR_ROOT=data/raw/tuar
CHBMIT_ROOT=data/raw/chbmit
SIENA_ROOT=data/raw/siena

# ── Outputs ──
OUTPUT_ROOT=outputs

# ── Experiment tracking (optional) ──
MLFLOW_TRACKING_URI=outputs/mlruns
# WANDB_API_KEY=

# ── Reproducibility ──
NEUROMECH_SEED=42
