{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: current file",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": true
    },
    {
      "name": "Script: data audit (P1)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/00_audit_tusz.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "Script: fine-tune (P5)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/10_finetune.py",
      "args": ["experiment=v11_fallback"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "Script: evaluate (P6)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/12_evaluate.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "Tests: all (synthetic)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-m", "not data and not slow", "-x"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false
    }
  ]
}
