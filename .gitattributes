# Normalise line endings in the repository
* text=auto eol=lf

# Windows scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.pdf  binary
*.png  binary
*.jpg  binary
*.edf  binary
*.parquet binary
*.h5   binary
*.hdf5 binary
*.pt   binary
*.onnx binary

# Notebooks: treat as text, but show them as generated in diffs
*.ipynb text eol=lf linguist-generated=true
